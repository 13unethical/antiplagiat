# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/antiplagiat

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Semantic search (Qdrant + embedding model) ────────────────────────────────
QDRANT_URL=http://localhost:6333
# BAAI/bge-m3 — multilingual, 1.1 GB (production)
# BAAI/bge-small-en-v1.5 — English-only, 33 MB (dev stub)
EMBED_MODEL=BAAI/bge-m3

# ── AI detector (RU/UZ ONNX + EN DocMaxxing) ──────────────────────────────────
# Каталог с model.onnx + токенайзер (см. backend/ml/README.md и OPS_AI_DETECTOR.md)
AI_MODEL_DIR=
# DocMaxxing DeBERTa для English (POST {URL}/score)
DOCMAXXING_AI_ENABLED=true
# Prod GCP detector (DocMaxxing): http://34.71.144.75:8081
DOCMAXXING_AI_URL=http://34.71.144.75:8081
DOCMAXXING_AI_KEY=
# 0 = взять threshold из /score|/healthz (prod сейчас 0.35); >0 = свой порог
DOCMAXXING_AI_THRESHOLD=0

# ── Web search (Brave Search API) ─────────────────────────────────────────────
# Free key: https://brave.com/search/api/
BRAVE_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_QUERIES=20
WEB_SEARCH_MAX_URLS=10
WEB_SEARCH_MATCH_THRESHOLD=70
WEB_SEARCH_CACHE_TTL=604800

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty → invitation links print to console instead of sending email.
# Gmail example:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_TLS=true
# Yandex example: SMTP_HOST=smtp.yandex.ru  SMTP_PORT=587  SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@antiplagiat.uz
SMTP_TLS=true

# ── LTI 1.3 (Canvas / Moodle) ─────────────────────────────────────────────────
# Public URL of this API (JWKS, OIDC redirects, Canvas originality launch)
API_PUBLIC_URL=http://localhost:8000
# RSA private key PEM for signing LTI client assertions (auto-created if missing)
LTI_PRIVATE_KEY_PATH=./lti_private.pem

# Антиплагиат без Docker:
# QDRANT_URL пуст -> локальный Qdrant на диске (QDRANT_PATH). Задайте URL для удалённого сервера.
QDRANT_URL=
QDRANT_PATH=./qdrant_local
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
